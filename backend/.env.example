# Environment & App Config
AI_ENV=development
API_VERSION=v1
APP_NAME="Secure AI Quiz Backend"
DEBUG=true

# Security & Authentication
JWT_SECRET_KEY=change-this-super-secret-key-for-production-min-32-chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Provider Configuration (Generic Architecture)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
AI_MOCK_MODEL=local-mock-v1
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (PostgreSQL in production, SQLite fallback in local dev)
DATABASE_URL=sqlite:///./sql_app.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_quiz_db

# Strict Resource & Processing Limits
MAX_FILE_SIZE_BYTES=26214400 # 25 MB
MAX_DOCUMENT_PAGES=100
MAX_EXTRACTED_CHARS=250000
MAX_CHUNKS_PER_DOC=50
MAX_OCR_PAGES=10
MAX_AI_TOKENS_PER_JOB=16000
MAX_QUESTIONS_PER_JOB=25
MAX_JOB_PROCESSING_TIMEOUT_SECONDS=120
MAX_CONCURRENT_JOBS_PER_USER=2
MAX_DAILY_AI_JOBS_PER_USER=10

# Ephemeral Storage Cleanup (TTL in seconds)
EPHEMERAL_FILE_TTL_SECONDS=3600
